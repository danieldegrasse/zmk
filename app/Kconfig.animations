# Animation driver types
config ZMK_ANIMATION_SOLID
    bool "Solid animation driver"
    default y if DT_HAS_ZMK_ANIMATION_SOLID_ENABLED

config ZMK_ANIMATION_COMPOSE
    bool "Animation compose driver"
    default y if DT_HAS_ZMK_ANIMATION_COMPOSE_ENABLED

config ZMK_ANIMATION_RIPPLE
    bool "Ripple animation driver"
    default y if DT_HAS_ZMK_ANIMATION_RIPPLE_ENABLED
